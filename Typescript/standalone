// Estructura de un componente standalone
//  mi proyecto-angular
// ├── .angular          # Caché local del compilador de Angular
// ├── .vscode           # Configuraciones para Visual Studio Code
// ├── node_modules      # Dependencias y librerías de Node.js
// ├── public             # Archivos estáticos públicos (imágenes, favicons)
// ├── src                # Código fuente de la aplicación
// │   ├── app            # Carpeta principal de la aplicación
// │   │   ├── index.html  # Archivo HTML principal de la aplicación
// │   │   ├── main.ts      # Punto de entrada de la aplicación (arranque)
// │   │   ├── styles.css   # Archivo de estilos principal de la aplicación
// │   │   ├── app.component.ts  # Componente raíz de la aplicación
// │   │   ├── app.component.html # Plantilla HTML del componente raíz
// │   │   ├── app.component.css  # Estilos específicos del componente raíz 
// │   │   └── ...           # Otros componentes, servicios, módulos, etc.
// ├── angular.json       # Configuración del proyecto Angular
// ├── package.json       # Configuración de dependencias y scripts de npm
// ├── tsconfig.json      # Configuración del compilador TypeScript
// └── ...                # Otros archivos de configuración y documentación