function funcUserLoggeo() {
  let authentication = localStorage.getItem('authentication');
  let UserName = localStorage.getItem('nameFisrtUser') + ' ' + localStorage.getItem('lastNameFisrtUser');
  if (authentication == 1) {
    //$('.wrapperMenu > li:last-child > a').text('Bienvenid@, ' + UserName);
    $('.wrapperBtnMenu').empty();
    $('.wrapperBtnMenu').removeAttr('data-bs-target');
    $('.wrapperBtnMenu').removeAttr('data-bs-toggle');
    $('.wrapperBtnMenu').text('Bienvenid@, ' + UserName);
    $('#userActionLogout, #userActionLogoutMobile').show();
  }
}


function filterProducts() {
  let boolNameFilter = false;
  let boolCategoryFilter = false;

  let input = document.getElementById('filterNameProducts');
  let filter = input.value.toUpperCase();

  let filterCat = document.getElementById('filterCateogryProducts');
  let filterCatValue = filterCat.value;

  if (filter != "") {
    boolNameFilter = true;
  }

  if (filterCatValue != "") {
    boolCategoryFilter = true;
  }

  $(".wrapperFilterResult .wrapperDisplayItemFi").each(function () {
    $(this).css('display', 'none');

    if (boolNameFilter) {
      let title = $(this).find("h3").text().toUpperCase();
      if (title.indexOf(filter) > -1) {
        $(this).css('display', 'block');
      }
    }

    if (boolCategoryFilter) {
      let categoryfilter = $(this).attr('data-categoryfilter');
      if (categoryfilter == filterCatValue || filterCatValue == "all") {
        $(this).css('display', 'block');
      }
    }
  });
}